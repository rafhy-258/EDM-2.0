{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tenant": {
    "Id": "00000000-0000-0000-0000-000000000001"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Identity": {
    "PasswordIterations": 600000,
    "MinimumPasswordLength": 12,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "IdleTimeoutMinutes": 20
  }
}
