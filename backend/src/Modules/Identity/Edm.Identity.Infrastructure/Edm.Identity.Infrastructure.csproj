<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Edm.Identity.Infrastructure</RootNamespace>
    <Description>Identity persistence on PostgreSQL: the account store, the PBKDF2 password hasher and the SQL migration.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQL migrations are embedded by file name, for example 0002_identity_schema.sql. -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Edm.Identity.Application\Edm.Identity.Application.csproj" />
    <ProjectReference Include="..\Edm.Identity.Domain\Edm.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\..\Shared\Edm.SharedKernel\Edm.SharedKernel.csproj" />
  </ItemGroup>
</Project>
