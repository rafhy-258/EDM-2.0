<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Edm.Configuration.Infrastructure</RootNamespace>
    <Description>Configuration persistence on PostgreSQL: the category and subcategory store and the SQL migrations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQL migrations are embedded by file name, for example 0003_configuration_categories.sql. -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Edm.Configuration.Application\Edm.Configuration.Application.csproj" />
    <ProjectReference Include="..\Edm.Configuration.Domain\Edm.Configuration.Domain.csproj" />
    <ProjectReference Include="..\..\..\Shared\Edm.SharedKernel\Edm.SharedKernel.csproj" />
  </ItemGroup>
</Project>
